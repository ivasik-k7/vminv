# =============================================================================
# vminv configuration  —  copy to ".env" and edit:   cp config.example.env .env
# =============================================================================
#
# This file is plain shell (KEY=VALUE) and is *sourced* by vminv.
#
# SECRETS POLICY
#   - Do NOT put your vCenter password in this file if you can avoid it.
#   - Preferred: export VCENTER_PASSWORD in your shell, or let vminv prompt you.
#   - Any value here can be overridden by an environment variable of the same
#     name set before you run vminv.
#   - The committed .gitignore excludes ".env" so it is never accidentally
#     pushed. Keep it that way.
#
# Everything below is read-only metadata describing WHAT to scan and HOW to
# size it. vminv never writes to vCenter.
# -----------------------------------------------------------------------------

# --- Connection -------------------------------------------------------------

# vCenter hostname or IP (NOT an ESXi host — point at vCenter for cluster data).
VCENTER_HOST="vcenter.example.com"

# Service account. Use a dedicated, built-in read-only role (see README).
VCENTER_USER="svc-vminv@vsphere.local"

# Password: leave UNSET here. vminv will read $VCENTER_PASSWORD from the
# environment, or prompt interactively (input hidden). Uncomment ONLY for
# throwaway lab use — it will be redacted from logs but is still plaintext here.
# VCENTER_PASSWORD=""

# Allow self-signed / untrusted TLS certs. Default false. If true, vminv warns
# loudly on every run. Strongly prefer importing the CA and leaving this false.
VCENTER_INSECURE="false"


# --- Scope filters (optional — scan large estates in slices) ----------------
# Leave blank to scan everything in reach of the service account.
# These accept the names as they appear in vCenter. VM_GLOB is a shell glob.

SCOPE_DATACENTER=""        # e.g. "DC-London"
SCOPE_CLUSTER=""           # e.g. "Prod-Cluster-01"
SCOPE_FOLDER=""            # e.g. "/DC-London/vm/Production"
SCOPE_VM_GLOB=""           # e.g. "web-*"   (matches VM names)


# --- Utilization / right-sizing ---------------------------------------------

# How far back to pull performance history, in days. Default 30.
PERF_WINDOW_DAYS="30"

# Metric rollup interval requested from vCenter. One of: realtime, daily,
# weekly, monthly. "daily" is the right granularity for a 30-day window and is
# retained far longer than realtime. Default daily.
PERF_INTERVAL="daily"


# --- Migration thresholds (used by the blocker/risk analysis) ---------------

# A single disk larger than this (GB) is flagged as a large-disk risk.
THRESHOLD_LARGE_DISK_GB="2048"

# Total provisioned VM footprint larger than this (GB) is flagged.
THRESHOLD_LARGE_VM_GB="8192"

# Virtual hardware (vmx) version at or below this is flagged as "very old".
# e.g. 9 corresponds to ESXi 5.x-era hardware.
THRESHOLD_OLD_HW_VERSION="9"

# Snapshot older than this many days is flagged as stale.
THRESHOLD_SNAPSHOT_AGE_DAYS="7"


# --- Cloud target -----------------------------------------------------------

# Default provider for right-sizing + OS support checks. Override with
# `vminv --target azure`. One of: aws | azure | gcp.
TARGET_PROVIDER="aws"


# --- Output -----------------------------------------------------------------

# Base directory for run outputs. Each run creates <dir>/<UTC-timestamp>/.
OUTPUT_DIR="./output"


# --- Scheduled upload / self-update -----------------------------------------

# Destination for `vminv schedule`/`--dest` to ship each run's output (a single
# .tar.gz). Scheme selects the backend; leave blank to keep output local only.
#   s3://bucket/prefix        (needs aws CLI; AWS creds via standard chain)
#   gs://bucket/prefix        (needs gcloud/gsutil)
#   az://container/prefix     (needs az; AZ_STORAGE_ACCOUNT)
#   sftp://user@host/path     (needs scp; ssh keys/agent)
#   https://host/repo/path    (curl PUT; JFrog Artifactory etc. — UPLOAD_TOKEN for Bearer auth)
#   /mnt/share/vminv          (local / NFS path)
UPLOAD_DEST=""

# GitHub repo (owner/name) used by `vminv upgrade` to fetch the latest release.
VMINV_REPO=""
